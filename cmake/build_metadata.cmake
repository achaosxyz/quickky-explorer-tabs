file(READ "${VERSION_FILE}" QUICKKY_VERSION)
string(STRIP "${QUICKKY_VERSION}" QUICKKY_VERSION)
if(NOT QUICKKY_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    message(FATAL_ERROR "VERSION must contain MAJOR.MINOR.PATCH.")
endif()
set(QUICKKY_FILE_VERSION "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},0")
string(TIMESTAMP QUICKKY_BUILD_TIME "%Y-%m-%d %H:%M:%S UTC" UTC)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/build_metadata.h"
    "#pragma once\n#define QUICKKY_VERSION L\"${QUICKKY_VERSION}\"\n#define QUICKKY_FILE_VERSION ${QUICKKY_FILE_VERSION}\n#define QUICKKY_BUILD_TIME L\"${QUICKKY_BUILD_TIME}\"\n")
