#pragma once

namespace quickky {
struct TrayStrings {
    const wchar_t* startup;
    const wchar_t* enable_tabs;
    const wchar_t* about;
    const wchar_t* exit;
    const wchar_t* about_title;
    const wchar_t* author;
    const wchar_t* version;
    const wchar_t* build_time;
    const wchar_t* compatibility;
    const wchar_t* compatibility_title;
    const wchar_t* dll_version;
    const wchar_t* compatibility_status;
    const wchar_t* native_supported;
    const wchar_t* native_unsupported;
    const wchar_t* compatibility_unavailable;
    const wchar_t* custom_tabs;
    const wchar_t* compatibility_note;
};
inline constexpr TrayStrings kEnglish{
    L"@en_startup@", L"@en_enableTabs@", L"@en_about@", L"@en_exit@",
    L"@en_title@", L"@en_author@", L"@en_version@", L"@en_buildTime@",
    L"@en_compatibility@", L"@en_compat_title@", L"@en_compat_dllVersion@", L"@en_compat_status@",
    L"@en_compat_supported@", L"@en_compat_unsupported@", L"@en_compat_unavailable@",
    L"@en_compat_customTabs@", L"@en_compat_note@"
};
inline constexpr TrayStrings kChinese{
    L"@zh_startup@", L"@zh_enableTabs@", L"@zh_about@", L"@zh_exit@",
    L"@zh_title@", L"@zh_author@", L"@zh_version@", L"@zh_buildTime@",
    L"@zh_compatibility@", L"@zh_compat_title@", L"@zh_compat_dllVersion@", L"@zh_compat_status@",
    L"@zh_compat_supported@", L"@zh_compat_unsupported@", L"@zh_compat_unavailable@",
