#include <windows.h>
#include "resource.h"
#include "build_metadata.h"

IDI_QUICKKY ICON "@CMAKE_CURRENT_SOURCE_DIR@/logo.ico"

1 VERSIONINFO
FILEVERSION QUICKKY_FILE_VERSION
PRODUCTVERSION QUICKKY_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "aCHAOS"
            VALUE "FileDescription", "Quickky Explorer Tabs"
            VALUE "FileVersion", QUICKKY_VERSION
            VALUE "InternalName", "QTabs"
            VALUE "OriginalFilename", "QTabs.exe"
            VALUE "ProductName", "Quickky Explorer Tabs"
            VALUE "ProductVersion", QUICKKY_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
